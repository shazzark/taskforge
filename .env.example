# Copy to .env locally. Never commit .env or paste secrets into chat.
# TaskForge loads this file from the repository root. Keep the real .env ignored and private.
TASKFORGE_MONGODB_URI=mongodb://<username>:<password>@127.0.0.1:27017/taskforge

# Phase 2 settings. Select exactly one provider; no automatic fallback.
TASKFORGE_PROVIDER=groq
TASKFORGE_GROQ_API_KEY=replace-with-your-own-groq-key
TASKFORGE_GROQ_MODEL=openai/gpt-oss-20b

# Optional local provider; no key needed for local Ollama.
# TASKFORGE_PROVIDER=ollama
TASKFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
TASKFORGE_OLLAMA_MODEL=qwen3:4b-q4_K_M
# Optional context size; defaults to 4096 and accepts 1024..131072.
# TASKFORGE_OLLAMA_CONTEXT_LENGTH=4096

# Optional Phase 6 search alternative; only needed if Tavily is selected.
# TASKFORGE_SEARCH_PROVIDER=tavily
# TASKFORGE_TAVILY_API_KEY=replace-with-your-own-tavily-key

# Optional Phase 7 access to private GitHub repositories only.
# Public repository reads should not need a token.
# TASKFORGE_GITHUB_TOKEN=replace-with-a-repository-scoped-read-only-token
