{
  "name": "taskforge",
  "version": "0.1.0",
  "description": "TaskForge is an early development local CLI assistant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shazzark/taskforge.git"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "taskforge": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc",
    "package:audit": "npm run build && node scripts/package-audit.mjs",
    "test": "npm run build && node --test --test-concurrency=1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/yauzl": "^3.4.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "fast-xml-parser": "^5.11.2",
    "groq-sdk": "^1.6.0",
    "mongodb": "7.6.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "playwright": "1.64.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^7.0.1",
      "unzipper": "^0.12.3"
    },
    "glob": "^13.0.6",
    "uuid": "^11.1.1"
  }
}
